      m_Calls: []
  m_text: "Beryl's Personal Notes\n\nThe reports I requested from Catsby Great are still missing. This is becoming unacceptable. If they are not submitted by tomorrow, I will have to reconsider his position here...\r\n\r\nI also noticed that he is the only employee without the plant I gave everyone for their desks! I'm not sure what happened to his, but I would like an explanation.\r\n\r\nReminder: Contact IT about the default passwords. We are still using the employee name based format, which is a serious security concern!\r\n\r\n\u2014 Beryl Nocat"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
